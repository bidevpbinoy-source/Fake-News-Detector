# ==========================================
# TruthLens AI - Environment Configuration
# ==========================================

# 1. Ollama (100% Free, Open Source & Local - Recommended!)
# Install from https://ollama.com and run: ollama run llama3.2
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# 2. NVIDIA NIM API Key (Cloud alternative)
# Get a key at: https://build.nvidia.com/
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct

# 2. Google Gemini API Key (Alternative AI engine)
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Google Fact Check Tools API Key (Optional but recommended)
# Can be generated in Google Cloud Console with 'Fact Check Tools API' enabled:
# https://console.cloud.google.com/apis/library/factchecktools.googleapis.com
FACT_CHECK_API_KEY=your_fact_check_api_key_here

# Optional: Default Gemini model to use (gemini-1.5-flash or gemini-2.0-flash)
GEMINI_MODEL=gemini-1.5-flash
